[user]
    name = Bartosz Taczała
    email = bartosz@chamsys.co.uk

[merge]
    ;tool = vimdiff
    tool = nvimdiff4
[gui]
    editor = gvim
    historybrowser = gitk
[color]
    sh = auto
    ui = auto
[core]
    editor = nvim
	autocrlf = false
    excludesfile = ~/.gitignore
    pager = delta
	eol = lf
[alias]
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    new = !sh -c 'git log $1@{1}..$1@{0} "$@"'
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
    la = "!git config -l | grep alias | cut -c 7-"
    ld = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=relative
    fl = log -u
    added = difftool --cached
    fbr = fzf-branch
    rups = "!f() { git fetch; git reset --hard origin/$(git rev-parse --abbrev-ref HEAD); }; f"
    s = "!f() { git fetch origin main && git rebase origin/main && git push --force-with-lease; }; f"
	next = stack next
	prev = stack previous
	reword = stack reword
	amend = stack amend
	run = stack run
	sync = stack sync
[push]
    default = simple
[cola]
    fontdiff = Hack,9,-1,5,50,0,0,0,0,0
    spellcheck = false
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f

# stolen from https://vimways.org/2018/vim-and-git/
[mergetool "nvimdiff4"]
    cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[mergetool "nfugitive"]
    cmd = nvim -f -c "Gdiff" "$MERGED"

[difftool]
    prompt = false

[diff]
    tool = nvimdiff4

[delta]
    line-numbers = true

[interactive]
    diffFilter = delta --color-only
[pull]
    ff = only
[blame]
    markIgnoredLines = true
    markUnblamableLines = true
[maintenance]
    repo = /Users/bartek/Projects/inmusic/mediamaster
