#!/bin/bash
# Wrapper for `bat` living in ~/dotfiles/bin (on PATH as `bat`), so it must call
# the real binary by absolute path to avoid recursing into itself. Names/paths
# differ per platform:
#   Fedora/Arch:   /usr/bin/bat
#   Debian/Ubuntu: /usr/bin/batcat   (renamed to avoid a package conflict)
#   macOS:         homebrew
for candidate in /usr/bin/bat /usr/bin/batcat /opt/homebrew/bin/bat /usr/local/bin/bat; do
  if [[ -x "$candidate" ]]; then
    bat_command="$candidate"
    break
  fi
done

if [[ -z "$bat_command" ]]; then
  echo "Error: real bat/batcat binary not found" >&2
  exit 1
fi

# macOS: follow the system light/dark appearance. Elsewhere: fixed light theme.
if [[ "$OSTYPE" == "darwin"* ]] && defaults read -globalDomain AppleInterfaceStyle &> /dev/null; then
  theme=default   # dark mode
else
  theme=GitHub    # light / non-macOS
fi

exec "$bat_command" --theme="$theme" "$@"
