font-family = "IosevkaTerm Nerd Font Mono"
# font-family = "Hack Nerd Font Mono Regular"
theme = "light:Tokyonight Day,dark:Tokyonight"
macos-titlebar-style = "tabs"

unfocused-split-opacity = 0.9
unfocused-split-fill = #000000

window-theme = "system"

keybind = ctrl+y>h=new_split:down
keybind = ctrl+y>v=new_split:right
keybind = ctrl+y>z=toggle_split_zoom

keybind = performable:ctrl+j=goto_split:left
keybind = performable:ctrl+k=goto_split:bottom
keybind = performable:ctrl+l=goto_split:top
keybind = performable:ctrl+;=goto_split:right

keybind = ctrl+shift+u=scroll_page_up
keybind = ctrl+shift+s=write_screen_file:open
keybind = ctrl+shift+d=scroll_page_down
keybind = performable:alt+k=resize_split:down,20
keybind = performable:alt+l=resize_split:up,20
keybind = performable:alt+j=resize_split:left,20
keybind = performable:alt+;=resize_split:right,20

keybind = ctrl+y>w=close_surface
keybind = ctrl+y>shift+w=close_tab
keybind = ctrl+y>s=write_scrollback_file:paste
keybind = ctrl+y>q=toggle_quick_terminal

shell-integration-features = ssh-terminfo
shell-integration-features = ssh-env

# Inside Neovim. Keys here must match the jkl; layout above (and the
# smart-splits keymaps in nvim/lua/config/keymaps.lua), not literal hjkl.
keybind = nvim/
# Move (left/down/up/right, sent as the raw bytes Ctrl+key would send anyway)
keybind = nvim/ctrl+j=text:\x0a
keybind = nvim/ctrl+k=text:\x0b
keybind = nvim/ctrl+l=text:\x0c
# Ctrl+; has no plain control byte; this is the CSI-u sequence Ghostty's
# kitty-keyboard-protocol would send for it anyway. Verify with :checkhealth
# and by pressing <C-;> at a split edge; if it doesn't register in Neovim,
# drop this line and ctrl+; will just fall back to goto_split:right below.
keybind = nvim/ctrl+;=text:\x1b[59;5u

# Resize (left/down/up/right), sent as Alt's usual ESC-prefix convention
keybind = nvim/alt+j=esc:j
keybind = nvim/alt+k=esc:k
keybind = nvim/alt+l=esc:l
keybind = nvim/alt+;=esc:;
